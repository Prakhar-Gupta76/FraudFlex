# Copy this file to .env. Local values require no external API keys.

# PostgreSQL used by Docker Compose and the Python services
FRAUDFLUX_POSTGRES_DB=fraudflux
FRAUDFLUX_POSTGRES_USER=fraudflux
FRAUDFLUX_POSTGRES_PASSWORD=fraudflux
FRAUDFLUX_POSTGRES_PORT=5432
FRAUDFLUX_POSTGRES_DSN=postgresql://fraudflux:fraudflux@127.0.0.1:5432/fraudflux

# Local Kafka uses PLAINTEXT and does not require credentials
FRAUDFLUX_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
FRAUDFLUX_KAFKA_PORT=9092
FRAUDFLUX_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
FRAUDFLUX_KAFKA_SASL_MECHANISM=
FRAUDFLUX_KAFKA_USERNAME=
FRAUDFLUX_KAFKA_PASSWORD=
FRAUDFLUX_KAFKA_CONSUMER_GROUP=fraudflux-scoring-worker

# Required before the API or worker starts
FRAUDFLUX_MODEL_ARTIFACT=models/isolation-forest-v1.joblib

# API and dashboard
FRAUDFLUX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:8000
